# Copy to .env in the repository root. Never commit .env.
APP_MODE=demo
# DeepSeek only. Set APP_MODE=live after adding your backend key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# Alternative: deepseek-flash. Check model availability in your account.
LLM_JSON_MODE=true
LLM_THINKING=false
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=45
LLM_CONCURRENCY=4
MAX_TURNS=8
MAX_DURATION=600
MAX_CALLS=180
DEMO_DELAY=1.3
SEED_ON_START=true
# Optional: DATABASE_URL=sqlite:///E:/1text1/panel.db
