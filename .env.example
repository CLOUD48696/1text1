# Copy to .env in the repository root. Never commit .env.
APP_MODE=demo
# live mode requires both key and an available model name.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_JSON_MODE=false
LLM_TIMEOUT=45
LLM_CONCURRENCY=4
MAX_TURNS=8
MAX_DURATION=600
MAX_CALLS=180
DEMO_DELAY=1.3
SEED_ON_START=true
# Optional: DATABASE_URL=sqlite:///E:/1text1/panel.db
